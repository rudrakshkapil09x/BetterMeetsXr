# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# SQLite (runtime data, not source)
*.db
*.db-shm
*.db-wal

# Node / frontend
node_modules/
npm-debug.log*
# Stale build output: vite writes to chrome-extension/dist, not here
better-google-meets/frontend/dist/

# Note: chrome-extension/dist/ is intentionally NOT ignored -- it's the built side panel
# the extension actually loads, and beta testers install the unpacked extension straight
# from this repo without running the Node toolchain. Run `npm run build` in frontend/ and
# commit the result whenever frontend/src changes.

# Env files (secrets / local overrides)
.env
.env.local

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Claude Code settings
.claude/settings.local.json
